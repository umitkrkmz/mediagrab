<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package of the Windows build (build/windows/MediaGrab),
  packed by build_msix.ps1. Identity Name/Publisher and PublisherDisplayName
  are the Store's own values from Partner Center (MediaGrab -> Product
  identity); a package with any other identity is rejected at upload. The
  Store signs the package with that Publisher. Tried locally with Developer
  Mode on and Add-AppxPackage -Register build\msix\layout\AppxManifest.xml: an
  unsigned .msix can't be installed at all (0x80073D2B "an unsigned package
  cannot include Executable activations"), so local tries use -Register.
  Version: the 4th part must stay 0 (the Store reserves it).

  Launch: python\MediaGrab.exe -m run - "-m run" rather than a path to
  run.py, because a packaged app's working directory is not the package
  folder; python314._pth already puts ..\app on sys.path, so run.py is found
  as a module wherever the package is installed.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="umitkrkmz.MediaGrab"
    Publisher="CN=299D0427-0828-45F7-8D31-BE979548312D"
    Version="2.5.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MediaGrab</DisplayName>
    <PublisherDisplayName>umitkrkmz</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-tr" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="MediaGrab"
      Executable="python\MediaGrab.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:Parameters="-m run">
      <uap:VisualElements
        DisplayName="MediaGrab"
        Description="Personal media archive: download video and music from 1700+ sites"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
